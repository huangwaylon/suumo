<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install with
  sed "s#__SUUMO_DIR__#$PWD#g" local.suumo.plist > ~/Library/LaunchAgents/local.suumo.plist
  (run from this folder; see README.md) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.suumo</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SUUMO_DIR__/.venv/bin/python</string>
        <string>-u</string>
        <string>-m</string>
        <string>suumo</string>
        <string>run</string>
        <string>--push</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__SUUMO_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- daily at 04:00; if the Mac was asleep then, launchd runs it once on wake -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__SUUMO_DIR__/logs/run.log</string>
    <key>StandardErrorPath</key>
    <string>__SUUMO_DIR__/logs/run.log</string>
</dict>
</plist>
