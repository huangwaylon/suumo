<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install with
  sed "s#__SUUMO_DIR__#$PWD#g" local.suumo-bot.plist > ~/Library/LaunchAgents/local.suumo-bot.plist
  (run from this folder; see README.md) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.suumo-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SUUMO_DIR__/.venv/bin/python</string>
        <string>-u</string>
        <string>-m</string>
        <string>suumo</string>
        <string>bot</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__SUUMO_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- always running: started at login, restarted if it crashes (not when it exits cleanly, e.g. a
         second copy that found the first one running) -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__SUUMO_DIR__/logs/bot.log</string>
    <key>StandardErrorPath</key>
    <string>__SUUMO_DIR__/logs/bot.log</string>
</dict>
</plist>
